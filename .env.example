# =============================================================================
# SmartWMS — Archivo de Configuración Central (.env.example)
# =============================================================================
# Copia este archivo como '.env' en la raíz del proyecto para personalizarlo:
#     copy .env.example .env
#
# -----------------------------------------------------------------------------
# 1. RED Y DIRECCIÓN DEL SERVIDOR
# -----------------------------------------------------------------------------
# En tu PC local usa 127.0.0.1
# Si te conectas desde otra PC o celular en la misma WiFi, escribe la IP de tu PC (ej: 192.168.1.50)
# Si usas una red privada virtual (ej: Tailscale), escribe tu IP de Tailscale (ej: 100.85.120.45)
SERVER_IP=127.0.0.1

# Puertos utilizados por los servicios
BACKEND_PORT=8001
BOT_PORT=8000
FRONTEND_PORT=4200

# -----------------------------------------------------------------------------
# 2. BASE DE DATOS
# -----------------------------------------------------------------------------
# Por defecto se utiliza SQLite embebido (archivo local independiente, sin instalar nada extra)
DATABASE_URL=sqlite:///./ecommerce.db

# Si en producción prefieres PostgreSQL, descomenta la siguiente línea:
# DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/smartwms_ecommerce

# -----------------------------------------------------------------------------
# 3. SEGURIDAD Y TOKENS JWT
# -----------------------------------------------------------------------------
# Secreto para firmar tokens JWT (debe ser idéntico en Backend y Bot)
JWT_SECRET=smartwms_super_secret_jwt_key_change_me_in_production
JWT_EXPIRE_MINUTES=120

# Secreto para validar firmas HMAC de webhooks de comercio electrónico
WEBHOOK_SECRET=smartwms_webhook_secret_key_change_me

# -----------------------------------------------------------------------------
# 4. AUTENTICACIÓN MULTIFACTOR (MFA / TOTP)
# -----------------------------------------------------------------------------
# Nombre que aparecerá en Google Authenticator / Microsoft Authenticator / Aegis
MFA_ISSUER=SmartWMS

# Roles que exigen MFA obligatoriamente ('*' para todos, o 'admin,supervisor,operario', o '' para desactivar)
MFA_REQUIRED_ROLES=*

# Clave Fernet (AES-128-CBC) para cifrar los secretos TOTP en la base de datos.
# Si se deja vacía en la primera ejecución, se generará una automáticamente y se guardará aquí.
MFA_ENCRYPTION_KEY=

# Seguridad y mitigación de fuerza bruta en MFA
MFA_MAX_ATTEMPTS=5
MFA_LOCK_MINUTES=5
MFA_VALID_WINDOW=1
MFA_TOKEN_EXPIRE_MINUTES=5

# -----------------------------------------------------------------------------
# 5. COPILOTO IA Y BOT TELEGRAM (OPCIONAL)
# -----------------------------------------------------------------------------
# Deja estos valores vacíos si no vas a utilizar el bot de Telegram o la API de Gemini
TELEGRAM_BOT_TOKEN=
GEMINI_API_KEY=

