<?xml version="1.0" encoding="utf-8"?>
<!-- fragment_picking.xml — Despacho de Pedidos del Operario -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark">

    <!-- ══ VISTA 1: LISTA DE PEDIDOS PENDIENTES ═══════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_orders_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📦 Pedidos Pendientes"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/tv_orders_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Selecciona un pedido para despacharlo"
            android:textSize="13sp"
            android:textColor="@color/text_muted"
            android:layout_marginBottom="16dp"/>

        <!-- Loading bar -->
        <ProgressBar
            android:id="@+id/progress_orders_loading"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:progressTint="@color/purple_primary"
            android:layout_marginBottom="8dp"/>

        <!-- Error banner -->
        <TextView
            android:id="@+id/tv_orders_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#ef4444"
            android:textSize="13sp"
            android:background="#1fef4444"
            android:padding="12dp"
            android:visibility="gone"
            android:layout_marginBottom="8dp"/>

        <!-- Estado vacío -->
        <LinearLayout
            android:id="@+id/layout_empty_orders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="40dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✅"
                android:textSize="48sp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sin pedidos pendientes"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="El supervisor aún no ha creado pedidos asignados a ti."
                android:textSize="13sp"
                android:textColor="@color/text_muted"
                android:gravity="center"/>
        </LinearLayout>

        <!-- Lista de pedidos -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_work_orders"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <!-- Botón refrescar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_refresh_orders"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="🔄 Actualizar pedidos"
            android:textSize="14sp"
            android:backgroundTint="@color/surface_dark"
            app:strokeColor="@color/purple_primary"
            app:strokeWidth="1dp"
            android:textColor="@color/purple_light"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_marginTop="8dp"/>
    </LinearLayout>


    <!-- ══ VISTA 2: DETALLE DEL PEDIDO SELECCIONADO ═══════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_order_detail"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <!-- Botón volver -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_back_to_list"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="← Volver"
                android:textSize="13sp"
                android:backgroundTint="@color/surface_dark"
                android:textColor="@color/purple_light"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                app:strokeColor="@color/purple_primary"
                app:strokeWidth="1dp"/>

            <TextView
                android:id="@+id/tv_order_id"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="WO-0001"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:fontFamily="monospace"
                android:gravity="end"/>
        </LinearLayout>

        <!-- Progress bar de picking -->
        <TextView
            android:id="@+id/tv_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0% completado"
            android:textColor="@color/purple_light"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <ProgressBar
            android:id="@+id/progress_picking"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100"
            android:progress="0"
            android:progressTint="@color/purple_primary"
            android:layout_marginBottom="16dp"/>

        <!-- Lista de items del pedido (con botón ❓) -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_picking_items"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <!-- Botón QR -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_scan_qr"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="📷 Escanear QR"
                android:textSize="14sp"
                android:textStyle="bold"
                android:backgroundTint="@color/surface_dark"
                android:textColor="@color/purple_light"
                app:strokeColor="@color/purple_primary"
                app:strokeWidth="1dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
